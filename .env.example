# Chaves de API - Configure suas chaves aqui
# Copie este arquivo para .env.local e preencha os valores

# OpenAI - para análise de fotos com GPT-4 Vision
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe - para pagamentos
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# URL base do app (mude para produção quando deployar)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Preço do relatório em centavos (R$ 47,00 = 4700)
STRIPE_PRICE_AMOUNT=4700
